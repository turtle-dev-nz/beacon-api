{
  "name": "card-monorepo",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/api"
  ],
  "scripts": {
    "start": "npm run start:mobile",
    "dev": "npm run dev:mobile",
    "dev:mobile": "npm --workspace @card/mobile run start --",
    "dev:mobile:lan": "npm --workspace @card/mobile run start -- --host lan",
    "dev:mobile:tunnel": "npm --workspace @card/mobile run start -- --host tunnel",
    "dev:api": "npm run dev --workspace @card/api",
    "start:mobile": "npm --workspace @card/mobile run start --",
    "start:api": "npm run start --workspace @card/api"
  }
}
